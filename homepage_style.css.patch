+.stc{position:relative;display:flex;flex-direction:column;gap:6px;padding:22px 20px 20px;background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden}
+.stc::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--gold)}
+.stn{font-size:clamp(2rem,6.5vw,3rem);line-height:1.05;font-weight:700;color:var(--gold-text);font-variant-numeric:tabular-nums;letter-spacing:-.01em}
